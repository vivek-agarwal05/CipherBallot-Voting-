# Core Flask & Environment
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_APP=run.py

# Database: SQLite locally, or PostgreSQL in production (Render / Railway / Neon / Supabase)
DATABASE_URL=sqlite:///cipherballet.db

# Rate limiting storage (use redis://... in production with multiple workers)
RATELIMIT_STORAGE_URL=memory://

# Deployment & Demo Visibility
SHOW_DEMO_HINTS=true
TRUST_PROXY=false
AUTO_INIT_DB=true
AUTO_INIT_KEYS=false
# SESSION_COOKIE_SECURE=true

# Optional: Bootstrap initial Admin user automatically on first boot
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=StrongAdminPassword!1
# ADMIN_DISPLAY_NAME=Election Administrator

# Cryptographic Keys (file paths locally, OR inline PEM strings on cloud hosts)
RSA_PRIVATE_KEY_PATH=instance/keys/rsa_private.pem
RSA_PUBLIC_KEY_PATH=instance/keys/rsa_public.pem
SIGNING_PRIVATE_KEY_PATH=instance/keys/signing_private.pem
SIGNING_PUBLIC_KEY_PATH=instance/keys/signing_public.pem
# RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n..."
# SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# SIGNING_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n..."

# Local HTTPS/TLS certificates (for run.py local dev & Wireshark lab)
TLS_CERT_PATH=instance/certs/cert.pem
TLS_KEY_PATH=instance/certs/key.pem

# Optional: Email delivery for Verification PINs & Password Resets
# Option A (Recommended on Render Free Tier — uses HTTPS Port 443 via Brevo):
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# MAIL_DEFAULT_SENDER=CipherBallot <your-verified-gmail@gmail.com>
# Option B (SMTP, e.g. local dev or paid cloud):
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=CipherBallot <you@example.com>
